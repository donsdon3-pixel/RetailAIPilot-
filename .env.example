# ======================================================================================
# RetailPilot AI - Environment Template (.env.example)
# Copy this file to .env.local and populate credentials as needed.
# ======================================================================================

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI API Configuration
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_AI_MODEL=gemini-2.0-flash

# Security Secrets
MCP_SERVER_SECRET=your-mcp-server-secret
CRON_SECRET=your-cron-secret-token

# Localization & System Defaults
NEXT_PUBLIC_APP_NAME="RetailPilot AI"
NEXT_PUBLIC_APP_URL="https://retail-ai-pilot.vercel.app"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_LOCALE="en-IN"
NEXT_PUBLIC_DEFAULT_ORG_ID="org_01"
NEXT_PUBLIC_DEFAULT_STORE_ID="store_01"
