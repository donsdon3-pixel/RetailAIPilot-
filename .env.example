# RetailPilot AI Environment Configuration

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_ORG_ID=org_01
NEXT_PUBLIC_DEFAULT_STORE_ID=store_01

# Supabase Database & Auth (Optional for Live Cloud Supabase Instance)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Business Assistant (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key

# Model Context Protocol (MCP) Configuration
MCP_PORT=3001
MCP_API_ENDPOINT=http://localhost:3000/api/mcp
